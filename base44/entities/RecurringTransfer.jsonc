{
  "name": "RecurringTransfer",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "copied_from": {
      "rls": {
        "write": false
      },
      "type": "string",
      "description": "Draft revisions: id of the record this one was copied from (set only by the server when a revision is created)."
    },
    "period_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "source": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "destination": {
      "type": "string",
      "description": "Destination account for the transfer when the workbook carries one (e.g. the savings account money lands in). Parsed from the transfer row's fourth column; blank stays blank."
    },
    "visible_to_client": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "period_id",
    "amount"
  ]
}