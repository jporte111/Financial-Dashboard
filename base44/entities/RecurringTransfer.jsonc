  "type": "object",
  "properties": {
    "period_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "visible_to_client": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
