{
  "name": "RecurringTransfer",
  "type": "object",
  // Direct entity access is admin-only for every operation. Anonymous visitors
  // (the no-login client view) get published data only through the backend
  // functions, which read with the service role and enforce publication and
  // field rules server-side (base44/shared/publicDashboardCore.ts).
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  },
  "properties": {
    "period_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "visible_to_client": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "period_id",
    "amount"
  ]
}