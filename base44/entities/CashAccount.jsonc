{
  "name": "CashAccount",
  "type": "object",
  "properties": {
    "period_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "bank",
        "investment"
      ],
      "default": "bank"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "period_id",
    "name"
  ]
}