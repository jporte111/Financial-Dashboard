{
  "name": "BudgetLine",
  "type": "object",
  "properties": {
    "period_id": {
      "type": "string"
    },
    "qb_code": {
      "type": "string",
      "description": "Reference account/category code (from the BVA workbook). There is no QuickBooks integration; this is a display-only reference code."
    },
    "qb_account_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Historical extra account names this line matches for the transaction drill-down, matched by normalized account name against locally stored Account records. There is no live QuickBooks connection \u2014 this only looks up records that already exist in the database."
    },
    "category": {
      "type": "string"
    },
    "budget_group": {
      "type": "string",
      "enum": [
        "fixed",
        "variable",
        "discretionary",
        "income",
        "savings",
        "unassigned"
      ],
      "default": "variable",
      "description": "'unassigned' is used only for a monitored BVA DETAIL category whose Fixed/Variable/Discretionary group has not yet been confirmed by an admin. Unassigned rows are excluded from group filters and never counted in group summary totals."
    },
    "month_actual": {
      "type": "number",
      "description": "Current-month actual for this line. Null / absent means the BVA workbook's month column was blank for this period — 'Source value missing', not a confirmed $0. No 0 default so a blank month column is never stored as a fabricated zero."
    },
    "ytd_actual": {
      "type": "number",
      "default": 0
    },
    "annual_budget": {
      "type": "number",
      "default": 0
    },
    "pace_method": {
      "type": "string",
      "enum": [
        "even",
        "custom",
        "none"
      ],
      "default": "even"
    },
    "expected_ytd_override": {
      "type": "number"
    },
    "drilldown_enabled": {
      "type": "boolean",
      "default": true
    },
    "bva_detail": {
      "type": "boolean",
      "default": false,
      "description": "True for a monitored BVA DETAIL category (a watchlist row that rolls up into a group, not a group-summary line). Detail rows are shown in Spending Detail and are NOT summed into group totals."
    },
    "group_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True once an admin has confirmed this detail category's Fixed/Variable/Discretionary group. Unconfirmed rows surface as 'Mapping requires review'."
    },
    "monthly_budget": {
      "type": "number",
      "description": "Explicit monthly budget / expected monthly allocation for This Month mode; when absent the dashboard derives annual_budget / 12"
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "period_id",
    "category"
  ]
}