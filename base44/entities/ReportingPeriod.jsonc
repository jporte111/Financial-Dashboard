{
  "name": "ReportingPeriod",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.published": {
            "$ne": true
          }
        },
        {
          "data.superseded": {
            "$ne": true
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.published": {
            "$ne": true
          }
        },
        {
          "data.superseded": {
            "$ne": true
          }
        }
      ]
    }
  },
  "properties": {
    "revision_of": {
      "rls": {
        "write": false
      },
      "type": "string",
      "description": "Draft revisions: id of the first version of this report (absent on the original)."
    },
    "revision_number": {
      "rls": {
        "write": false
      },
      "type": "number",
      "description": "Draft revisions: 1 (or absent) for the original, 2, 3, ... for revisions."
    },
    "supersedes": {
      "rls": {
        "write": false
      },
      "type": "string",
      "description": "Draft revisions: id of the version this revision was copied from and replaces when published."
    },
    "superseded": {
      "rls": {
        "write": false
      },
      "type": "boolean",
      "description": "True once a newer version replaced this one. A superseded version is kept, read-only through the app, and never shown to clients."
    },
    "superseded_by": {
      "rls": {
        "write": false
      },
      "type": "string",
      "description": "Id of the revision that replaced this version."
    },
    "superseded_at": {
      "rls": {
        "write": false
      },
      "type": "string"
    },
    "revision_reason": {
      "rls": {
        "write": false
      },
      "type": "string",
      "description": "Why the revision was created."
    },
    "revision_created_by": {
      "rls": {
        "write": false
      },
      "type": "string"
    },
    "revision_created_at": {
      "rls": {
        "write": false
      },
      "type": "string"
    },
    "revision_status": {
      "rls": {
        "write": false
      },
      "type": "string",
      "enum": ["open", "discarded"],
      "description": "A discarded revision is ignored everywhere while it is being deleted."
    },
    "copy_status": {
      "rls": {
        "write": false
      },
      "type": "string",
      "enum": ["copying", "verified", "failed"],
      "description": "Whether the initial copy of the source report was completed and verified (rows, values, relationships). Finalization requires verified."
    },
    "copy_verification": {
      "rls": {
        "write": false
      },
      "type": "object",
      "description": "The copy verification report."
    },
    "label": {
      "type": "string",
      "description": "e.g. July 2026"
    },
    "month": {
      "type": "number"
    },
    "year": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "rls": {
        "write": false
      },
      "type": "string",
      "enum": [
        "draft",
        "transactions_posted",
        "categories_reviewed",
        "classes_reviewed",
        "reports_reviewed",
        "final"
      ],
      "default": "draft"
    },
    "months_elapsed": {
      "type": "number"
    },
    "published": {
      "rls": {
        "write": false
      },
      "type": "boolean",
      "default": false
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "reviewed_by": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "total_cash": {
      "type": "number"
    },
    "ytd_income": {
      "type": "number"
    },
    "ytd_expenses": {
      "type": "number"
    },
    "month_income": {
      "type": "number",
      "description": "Current-month income. Null / absent means the BVA workbook carried no month figure for this period (dashboard shows 'Source value missing'); an explicit 0 is a confirmed zero. No 0 default so a missing value is never stored as a fabricated zero."
    },
    "month_expenses": {
      "type": "number",
      "description": "Current-month expenses. Null / absent means not provided by the BVA workbook (dashboard shows 'Source value missing'); an explicit 0 is a confirmed zero."
    },
    "distributions_ytd": {
      "type": "number"
    },
    "savings_in_ytd": {
      "type": "number",
      "description": "Savings / Distributions In (YTD). Not present in the BVA workbook \u2014 a manually entered value. Null / absent means it has not been entered and mapping is unverified (dashboard shows 'Mapping requires review'); an explicit 0 is a confirmed zero. No 0 default."
    },
    "savings_spend_ytd": {
      "type": "number",
      "description": "Expenses Paid From Savings (YTD). Not present in the BVA workbook \u2014 a manually entered value. Null / absent means not entered / mapping unverified; an explicit 0 is a confirmed zero. No 0 default."
    },
    "checklist": {
      "type": "object",
      "properties": {
        "categories_reviewed": {
          "type": "boolean",
          "default": false
        },
        "classes_reviewed": {
          "type": "boolean",
          "default": false
        },
        "refunds_reviewed": {
          "type": "boolean",
          "default": false
        },
        "income_reviewed": {
          "type": "boolean",
          "default": false
        },
        "cash_confirmed": {
          "type": "boolean",
          "default": false
        },
        "distributions_confirmed": {
          "type": "boolean",
          "default": false
        },
        "budget_report_reviewed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "internal_notes": {
      "type": "string"
    },
    "reporting_cutoff_date": {
      "type": "string",
      "format": "date",
      "description": "Confirmed BVA reporting cutoff (e.g. 2026-07-31). Drives elapsed months, pace, and every 'as of' / 'through' label. Not inferred from the workbook filename."
    },
    "source_filename": {
      "type": "string",
      "description": "Original filename of the imported BVA workbook"
    },
    "imported_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent BVA workbook import"
    },
    "imported_by": {
      "type": "string",
      "description": "User (email / name) who ran the most recent BVA import"
    },
    "finalized_at": {
      "rls": {
        "write": false
      },
      "type": "string",
      "description": "ISO timestamp when the period was marked Final"
    },
    "finalized_by": {
      "rls": {
        "write": false
      },
      "type": "string"
    },
    "bva_import_status": {
      "rls": {
        "write": false
      },
      "type": "string",
      "enum": [
        "draft",
        "final"
      ],
      "default": "draft",
      "description": "BVA import lifecycle, separate from the existing review-workflow 'status' field"
    },
    "annual_budgeted_income": {
      "type": "number",
      "description": "Independently calculated total annual income budget (sum of income line budgets)"
    },
    "annual_budgeted_income_workbook": {
      "type": "number",
      "description": "The annual income budget total as printed in the workbook (also what annual_budgeted_income shows when present)"
    },
    "printed_totals": {
      "type": "boolean",
      "description": "Set by a BVA import made under the printed-total rule: the dashboard shows the workbook's printed totals for this period. Absent on earlier periods, which are shown as they were published."
    },
    "distribution_quarter_totals": {
      "type": "object",
      "description": "The distribution quarter column totals the BVA workbook prints ({ q1..q4 }, only those printed). Shown on the dashboard's Total row when present."
    },
    "annual_budgeted_expenses": {
      "type": "number",
      "description": "Total annual expense budget (Fixed + Variable + Discretionary)"
    },
    "monthly_income_budget": {
      "type": "number",
      "description": "Explicitly imported monthly income budget baseline; when absent the dashboard derives annual / 12"
    },
    "bva_validation_warnings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Independent-validation warnings for this period: { code, section, message, sourceValue, calculatedValue, requiresAdminReview, blocksFinalize, overridden, override }"
    },
    "source_missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of numeric fields whose source value is missing (blank in the workbook or left blank in Admin). Readers treat a listed field as missing whatever is stored: Base44 cannot store null, and a missing value must never read as $0.00. See base44/shared/sourceMissing.ts."
    },
    "reopen_log": {
      "rls": {
        "write": false
      },
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Audit trail of exceptional reopen operations: { at, by, reason, was_published }. Written only by the periodTransition function."
    },
    "checklist_confirmations": {
      "rls": {
        "write": false
      },
      "type": "object",
      "description": "Phase 6c: who confirmed each pre-publication checklist item and when, with a fingerprint of the data the item covers and the linked warnings seen at the time. Written only by the periodTransition backend (confirm_checklist / unconfirm_checklist). A confirmation goes stale when that data changes. Never removed."
    },
    "bva_overrides": {
      "rls": {
        "write": false
      },
      "type": "object",
      "description": "Map of warning code -> { reason, by, at } recorded when an authorized user accepts a discrepancy"
    },
    "bva_parsed_source": {
      "type": "object",
      "description": "Raw parsed values from the last workbook import, retained for the Admin review view. NEVER modified by corrections \u2014 the Import screen's corrections live in bva_corrections and are applied as a layer over this."
    },
    "bva_corrections": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Corrections and override reasons recorded in the BVA Import screen, persisted to the import draft so they survive refreshes and failed finalization: { id, kind (source|zero_confirm|transfer|group|savings|override), target, path, original_value, value, reason, by, at }. Applied as a layer over bva_parsed_source (which is never modified) and carried through Apply and Finalize."
    }
  },
  "required": [
    "label",
    "month",
    "year"
  ]
}