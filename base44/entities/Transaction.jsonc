{
  "name": "Transaction",
  "type": "object",
  // Direct entity access is admin-only for every operation. Anonymous visitors
  // (the no-login client view) get published data only through the backend
  // functions, which read with the service role and enforce publication and
  // field rules server-side (base44/shared/publicDashboardCore.ts).
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  },
  "properties": {
    "period_id": {
      "type": "string"
    },
    "qb_transaction_id": {
      "type": "string",
      "description": "Historical QuickBooks transaction id, set only on records created while the QuickBooks connector was active. The QuickBooks connector and sync functions have been removed; this field is retained solely so existing historical records keep their identity, and nothing writes to it any more."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "vendor": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "expense",
        "income",
        "transfer",
        "distribution",
        "refund"
      ],
      "default": "expense"
    },
    "qb_account": {
      "type": "string"
    },
    "account_id": {
      "type": "string",
      "description": "Linked Account id in the chart of accounts (for budget roll-up)"
    },
    "full_account_path": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "budget_group": {
      "type": "string",
      "enum": [
        "fixed",
        "variable",
        "discretionary",
        "income",
        "savings"
      ]
    },
    "treatment": {
      "type": "string",
      "enum": [
        "personal",
        "snvs",
        "unclassified"
      ],
      "default": "personal"
    },
    "is_refund": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "enum": [
        "quickbooks",
        "manual",
        "import"
      ],
      "default": "manual"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "needs_review",
        "reviewed"
      ],
      "default": "unreviewed"
    },
    "review_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_by": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "period_id",
    "date",
    "amount"
  ]
}