{
  "name": "SavedReport",
  "type": "object",
  // Direct entity access is admin-only for every operation. Anonymous visitors
  // (the no-login client view) get published data only through the backend
  // functions, which read with the service role and enforce publication and
  // field rules server-side (base44/shared/publicDashboardCore.ts).
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  },
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "budget_summary",
        "category_detail",
        "savings",
        "distributions",
        "cash"
      ],
      "default": "category_detail"
    },
    "category": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "internal",
        "client"
      ],
      "default": "internal"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}