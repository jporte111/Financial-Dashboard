{
  "name": "SavedReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "budget_summary",
        "category_detail",
        "savings",
        "distributions",
        "cash"
      ],
      "default": "category_detail"
    },
    "category": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "internal",
        "client"
      ],
      "default": "internal"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}