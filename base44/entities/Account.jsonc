{
  "name": "Account",
  "type": "object",
  "properties": {
    "account_code": {
      "type": "string",
      "description": "Account number / code (historically from QuickBooks; the QuickBooks integration has been removed)"
    },
    "account_name": {
      "type": "string"
    },
    "full_account_path": {
      "type": "string",
      "description": "Full colon-delimited account path, e.g. 'Discretionary Costs:Fitness & Self Care:Beauty Supplies' (historically from QuickBooks)"
    },
    "parent_account_id": {
      "type": "string",
      "description": "Direct parent Account id in the hierarchy"
    },
    "top_level_group": {
      "type": "string",
      "enum": [
        "fixed",
        "variable",
        "discretionary",
        "income",
        "savings"
      ],
      "default": "discretionary"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "expense",
        "income",
        "other"
      ],
      "default": "expense"
    },
    "annual_budget": {
      "type": "number",
      "default": 0
    },
    "has_own_budget": {
      "type": "boolean",
      "default": false
    },
    "budget_parent_id": {
      "type": "string",
      "description": "Account whose budget this account rolls into (used when has_own_budget is false)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "quickbooks",
        "manual",
        "import"
      ],
      "default": "manual"
    },
    "quickbooks_account_id": {
      "type": "string",
      "description": "Historical QuickBooks account id, set only on records created while the QuickBooks connector was active. The QuickBooks connector and sync functions have been removed; this field is retained solely so existing historical records keep their identity, and nothing writes to it any more."
    }
  },
  "required": [
    "account_name"
  ]
}