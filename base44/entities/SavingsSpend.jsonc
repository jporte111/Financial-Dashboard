{
  "name": "SavingsSpend",
  "type": "object",
  // Direct entity access is admin-only for every operation. Anonymous visitors
  // (the no-login client view) get published data only through the backend
  // functions, which read with the service role and enforce publication and
  // field rules server-side (base44/shared/publicDashboardCore.ts).
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  },
  "properties": {
    "copied_from": {
      "rls": {
        "write": false
      },
      "type": "string",
      "description": "Draft revisions: id of the record this one was copied from (set only by the server when a revision is created)."
    },
    "period_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "ytd_amount": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "period_id",
    "category"
  ]
}